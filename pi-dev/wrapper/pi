#!/usr/bin/env bash
set -euo pipefail

DIR_NAME="$(basename "$PWD" | tr -cs 'a-zA-Z0-9.-' '-' | sed 's/^-//;s/-$//')"
SANDBOX_NAME="pi-${DIR_NAME:-workspace}"

SANDBOXES="$(sbx ls)"
if ! printf '%s\n' "$SANDBOXES" | awk -v name="$SANDBOX_NAME" '
  $1 == name { found = 1 }
  END { exit !found }
'; then
  sbx run -d --name "$SANDBOX_NAME" \
    "git+https://github.com/gibenez/sbx-kits.git#dir=pi-dev" \
    --kit-arg llmapi_domain="your.llmapi.domain" \
    "$PWD" /var/folders/_j >/dev/null
fi

exec sbx run --name "$SANDBOX_NAME" -- "$@"
