#!/usr/bin/env bash
# Host wrapper: native Pi TUI, piped RPC and print, sharing host-managed skills.
set -euo pipefail

fail() { printf 'pi-sbx: %s\n' "$*" >&2; exit 1; }

# Update the host wrapper using the same published installer as a fresh install.
if [[ $# == 1 && "$1" == --sbx-update ]]; then
  installer="$(curl -q -fsSL https://raw.githubusercontent.com/gibenez/sbx-kits/main/pi-dev/install.sh)" ||
    fail 'could not download the wrapper installer'
  [[ -n "$installer" ]] || fail 'the wrapper installer download was empty'
  exec bash -c "$installer"
fi

KIT_REF="${SBX_PI_KIT:-git+https://github.com/gibenez/sbx-kits.git#dir=pi-dev}"

# Orca's standalone catalog process runs in HOME with exactly these args for
# an unadorned Pi Command. Never intercept workspace RPC or one-shot print.
if [[ . -ef "$HOME" && $# == 3 && $1 == --mode && $2 == rpc && $3 == --no-session ]]; then
  command -v python3 >/dev/null || fail 'python3 is required for the Orca model catalog'
  # Keep stdin available for RPC. The installer distributes this single file.
  exec python3 -c '
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
from urllib.parse import parse_qsl, quote

MODEL_FILE = "files/home/.pi/agent/models.json"
CACHE_TTL = 3600


def project_models(entries):
    models = []
    seen = set()
    for provider, row in entries:
        model_id = row["id"]
        if (not isinstance(provider, str) or not provider.strip() or "/" in provider
                or not isinstance(model_id, str) or not model_id.strip()
                or (provider, model_id) in seen):
            raise ValueError("invalid or duplicate model")
        seen.add((provider, model_id))
        model = {"provider": provider, "id": model_id}
        if isinstance(row.get("name"), str):
            model["name"] = row["name"]
        if isinstance(row.get("reasoning"), bool):
            model["reasoning"] = row["reasoning"]
        levels = row.get("thinkingLevelMap")
        if isinstance(levels, dict):
            model["thinkingLevelMap"] = {key: value for key, value in levels.items()
                                         if value is None or isinstance(value, str)}
        models.append(model)
    if not models:
        raise ValueError("empty catalog")
    return models


def read_config(config):
    return project_models((provider, row)
                          for provider, definition in config["providers"].items()
                          for row in definition.get("models", []))


def github_models_url(kit):
    match = re.fullmatch(r"git\+https://github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?(?:#(.*))?", kit, re.ASCII)
    if not match:
        raise ValueError("not a GitHub kit")
    owner, repo, fragment = match.groups()
    pairs = parse_qsl(fragment or "", keep_blank_values=True, strict_parsing=True)
    params = dict(pairs)
    if len(params) != len(pairs) or params.keys() - {"ref", "dir"}:
        raise ValueError("unsupported kit fragment")
    # The published kit uses main. For other repos require an explicit ref.
    revision = params.get("ref", "main" if (owner, repo) == ("gibenez", "sbx-kits") else "")
    directory = params.get("dir", "")
    paths = [owner, repo, revision] + ([directory] if directory else [])
    if not all(re.fullmatch(r"[a-zA-Z0-9_.-]+", part) and part not in (".", "..")
               for path in paths for part in path.split("/")):
        raise ValueError("unsupported kit ref or path")
    revision = quote(revision, safe="")
    return (f"https://raw.githubusercontent.com/{owner}/{repo}/{revision}/"
            + (directory + "/" if directory else "") + MODEL_FILE)


def load_models(kit):
    if Path(kit).is_dir():
        return read_config(json.loads((Path(kit) / MODEL_FILE).read_bytes()))
    url = github_models_url(kit)
    root = Path(os.getenv("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "pi-sbx" / "catalogs"
    cache = root / (hashlib.sha256(url.encode()).hexdigest() + ".json")
    cached = None
    try:
        rows = json.loads(cache.read_bytes())
        cached = project_models((row["provider"], row) for row in rows)
        if time.time() - cache.stat().st_mtime < CACHE_TTL:
            return cached
    except (OSError, ValueError, AttributeError, KeyError, TypeError):
        pass
    try:
        result = subprocess.run(["curl", "-q", "-fsSL", "--proto", "=https", "--proto-redir", "=https",
                                 "--connect-timeout", "2", "--max-time", "5", "--max-filesize", "1048576", url],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                check=True, timeout=6)
        models = read_config(json.loads(result.stdout))
    except (OSError, ValueError, AttributeError, KeyError, TypeError, subprocess.SubprocessError):
        if cached is None:
            raise
        print("pi-sbx: catalog refresh failed; using cached models", file=sys.stderr)
        return cached
    try:
        root.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", dir=root, delete=False) as output:
            temporary = Path(output.name)
            try:
                json.dump(models, output)
                output.close()
                temporary.replace(cache)
            finally:
                if temporary.exists():
                    temporary.unlink()
    except OSError:
        pass  # A cache write failure must not discard a valid catalog.
    return models


catalog = None
for line in sys.stdin:
    try:
        request = json.loads(line)
    except ValueError:
        continue
    if not isinstance(request, dict) or not isinstance(request.get("type"), str):
        continue
    command = request["type"]
    response = {"type": "response", "command": command, "success": True}
    if "id" in request:
        response["id"] = request["id"]
    if command == "get_state":
        response["data"] = {}
    elif command == "get_available_models":
        try:
            if catalog is None:
                catalog = load_models(sys.argv[1])
            response["data"] = {"models": catalog}
        except (OSError, ValueError, AttributeError, KeyError, TypeError, subprocess.SubprocessError):
            response.update(success=False, error="pi-sbx: kit model catalog unavailable; check SBX_PI_KIT and GitHub connectivity")
    else:
        response.update(success=False, error="pi-sbx: catalog discovery only; no chat session")
    print(json.dumps(response), flush=True)
' "$KIT_REF"
fi

DIR_NAME="$(basename "$PWD" | tr -cs 'a-zA-Z0-9.-' '-' | sed 's/^-//;s/-$//')"
SANDBOX_NAME="${SBX_PI_SANDBOX_NAME:-pi-${DIR_NAME:-workspace}}"
[[ "$SANDBOX_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$ ]] || fail 'invalid sandbox name'
CACHE_DIR="${SBX_PI_VERSION_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/pi-sbx/versions}"
VERSION_FILE="$CACHE_DIR/$SANDBOX_NAME.version"
VERSION_NUMBER='(0|[1-9][0-9]*)'
VERSION_PRERELEASE='(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)'
SEMVER="^$VERSION_NUMBER\\.$VERSION_NUMBER\\.$VERSION_NUMBER(-$VERSION_PRERELEASE(\\.$VERSION_PRERELEASE)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"

RPC=0
PRINT=0
NO_SKILLS=0
SESSION_DIR_SET=0
VERSION_REQUESTED=0
# Consume value-bearing built-in options so prompts such as '--mode' are not
# mistaken for mode selectors. Stop at Pi's literal-argument delimiter.
classify_args() {
  # Subcommands have their own option grammar; do not reinterpret their flags.
  case "${1:-}" in install|remove|uninstall|update|list|config|auth|mcp) return 0 ;; esac
  while (( $# )); do
    case "$1" in
      --) break ;;
      --version|-v) VERSION_REQUESTED=1 ;;
      --print|-p) PRINT=1 ;;
      --mode)
        if (( $# > 1 )); then
          [[ "$2" != rpc ]] || RPC=1
          [[ "$2" == rpc ]] || RPC=0
          shift
        fi ;;
      --no-skills|-ns) NO_SKILLS=1 ;;
      --session-dir)
        SESSION_DIR_SET=1
        if (( $# > 1 )); then shift; fi ;;
      --provider|--model|--api-key|--thinking|--models|--session|--session-id|--fork|--name|-n|--tools|-t|--exclude-tools|-xt|--extension|-e|--skill|--prompt-template|--theme|--use-theme|--system-prompt|--append-system-prompt|--tui-mode|--export)
        if (( $# > 1 )); then shift; fi ;;
    esac
    shift
  done
}
classify_args "$@"

# These paths deliberately precede ALL sbx calls and directory creation.
if (( VERSION_REQUESTED )); then
  VERSION=''
  if [[ -r "$VERSION_FILE" ]]; then
    IFS= read -r VERSION < "$VERSION_FILE" || true
  fi
  if [[ "$VERSION" =~ $SEMVER ]]; then
    printf '%s\n' "$VERSION"
    exit 0
  fi
  fail "version unavailable for $SANDBOX_NAME; start Pi normally or use --sbx-refresh-version on an existing sandbox"
fi
if [[ $# == 1 && "$1" == --sbx-clear-version ]]; then
  rm -f -- "$VERSION_FILE"
  exit 0
fi

REFRESH_ONLY=0
[[ $# != 1 || "$1" != --sbx-refresh-version ]] || REFRESH_ONLY=1
# Even a failed lookup must invalidate an explicitly refreshed cache.
if (( REFRESH_ONLY )); then rm -f -- "$VERSION_FILE"; fi
SANDBOXES="$(sbx ls --no-input </dev/null)"
EXISTS=0
if printf '%s\n' "$SANDBOXES" | awk -v name="$SANDBOX_NAME" '
  $1 == name { found = 1 }
  END { exit !found }
'; then
  EXISTS=1
fi
if (( ! EXISTS )); then rm -f -- "$VERSION_FILE"; fi
if (( REFRESH_ONLY && ! EXISTS )); then
  fail "sandbox $SANDBOX_NAME does not exist; version refresh will not create it"
fi
if (( ! EXISTS )) && [[ "${SBX_PI_REQUIRE_EXISTING:-0}" == 1 ]]; then
  fail "sandbox $SANDBOX_NAME does not exist; SBX_PI_REQUIRE_EXISTING forbids creation"
fi

# exec does not source the sandbox's persistent environment automatically.
# Keep any shell-setup diagnostics away from RPC/print stdout.
PI_EXEC='if [[ -r /etc/sandbox-persistent.sh ]]; then source /etc/sandbox-persistent.sh >&2; fi; exec pi "$@"'
PI_ENV='PI_CODING_AGENT_DIR=/home/agent/.pi/agent'
exec_piped_pi() {
  exec sbx exec --no-input -i --workdir "$PWD" --env "$PI_ENV" -- \
    "$SANDBOX_NAME" bash -c "$PI_EXEC" pi "$@"
}
refresh_version() {
  local version temporary
  # Clear first: a failed refresh must not keep advertising an older release.
  rm -f -- "$VERSION_FILE" || return 1
  if ! version="$(sbx exec --no-input --env "$PI_ENV" -- "$SANDBOX_NAME" bash -c "$PI_EXEC" pi --version </dev/null)"; then
    return 1
  fi
  version="${version%$'\r'}"
  [[ "$version" =~ $SEMVER ]] || return 1
  (
    umask 077
    mkdir -p -- "$CACHE_DIR" || exit 1
    temporary="$(mktemp "$CACHE_DIR/.${SANDBOX_NAME}.XXXXXXXX")" || exit 1
    if ! printf '%s\n' "$version" > "$temporary" || ! mv -f -- "$temporary" "$VERSION_FILE"; then
      rm -f -- "$temporary"
      exit 1
    fi
  ) || return 1
}
if (( REFRESH_ONLY )); then
  refresh_version || fail "could not verify installed Pi version in $SANDBOX_NAME"
  IFS= read -r VERSION < "$VERSION_FILE"
  printf '%s\n' "$VERSION"
  exit 0
fi

# Context-free Orca probes may run in home. Never provision a sandbox whose
# primary workspace would accidentally expose the whole home directory.
if (( (RPC || PRINT) && ! EXISTS )) && [[ "$PWD" -ef "$HOME" ]]; then
  fail 'refusing to create a non-interactive sandbox in the home directory; use a project directory instead'
fi

HOST_SKILLS="${SBX_PI_SKILLS_DIR:-$HOME/.agents/skills}"
STATE_ROOT="${SBX_PI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pi-sbx}"
# Match Pi's cwd buckets and Orca's host transcript scanner. Share only this
# project's bucket, never the host account's auth/config or other projects.
HOST_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
[[ "$HOST_AGENT_DIR" == /* ]] || fail 'host PI_CODING_AGENT_DIR must be absolute'
SESSION_BUCKET="--$(printf '%s' "${PWD#/}" | tr '/\\:' '---')--"
SESSION_DIR="$HOST_AGENT_DIR/sessions/$SESSION_BUCKET"
# Mount syntax uses ':' as a separator, without an escaping convention.
[[ "$HOST_SKILLS" != *:* && "$STATE_ROOT" != *:* && "$PWD" != *:* && "$HOST_AGENT_DIR" != *:* ]] || fail 'workspace, skill, state and account paths must not contain colons'
[[ ! -L "$SESSION_DIR" ]] || fail 'session bucket must be a real directory for Orca discovery'
(
  umask 077
  mkdir -p -- "$HOST_SKILLS" "$STATE_ROOT/$SANDBOX_NAME" "$SESSION_DIR"
)
HOST_SKILLS="$(cd "$HOST_SKILLS" && pwd -P)"
STATE_DIR="$(cd "$STATE_ROOT/$SANDBOX_NAME" && pwd -P)"
SESSION_DIR="$(cd "$SESSION_DIR" && pwd -P)"
SKILL_TARGET=/mnt/pi-host-skills

if (( ! EXISTS )); then
  WORKSPACES=("$PWD" "$HOST_SKILLS:$SKILL_TARGET:ro" "$STATE_DIR" "$SESSION_DIR")
  # Keep the original macOS temporary-directory share when present.
  [[ ! -d /var/folders/_j ]] || WORKSPACES+=(/var/folders/_j)
  sbx run --no-input -d --name "$SANDBOX_NAME" \
    "$KIT_REF" \
    --kit-arg "llmapi_domain=${SBX_PI_LLMAPI_DOMAIN:-your.llmapi.domain}" \
    "${WORKSPACES[@]}" </dev/null >/dev/null
  (umask 077
    printf '%s\n' "$HOST_SKILLS" > "$STATE_DIR/.skills-source"
    printf '%s\n' "$SESSION_DIR" > "$STATE_DIR/.sessions-dir")
fi
[[ -r "$STATE_DIR/.skills-source" ]] || fail "sandbox $SANDBOX_NAME has no wrapper mount record; migrate it explicitly (see pi-dev/README.md)"
IFS= read -r MOUNTED_SKILLS < "$STATE_DIR/.skills-source"
[[ "$MOUNTED_SKILLS" == "$HOST_SKILLS" ]] || fail 'skill source changed; an existing sandbox mount cannot be retargeted by reattaching'

[[ -r "$STATE_DIR/.sessions-dir" ]] || fail "sandbox $SANDBOX_NAME has no discoverable session mount; migrate it explicitly (see pi-dev/README.md)"
IFS= read -r MOUNTED_SESSIONS < "$STATE_DIR/.sessions-dir"
[[ "$MOUNTED_SESSIONS" == "$SESSION_DIR" ]] || fail 'session bucket changed; use the original workspace/account or migrate the sandbox explicitly'

# Fail closed for old sandboxes rather than silently falling back to their
# private skills or returning host-unreadable sessions. The marker proves the
# state directory is shared, not merely present in the sandbox filesystem.
MOUNT_PROBE="$(umask 077; mktemp "$STATE_DIR/.mount-check.XXXXXXXX")"
SESSION_PROBE="$(umask 077; mktemp "$SESSION_DIR/.mount-check.XXXXXXXX")"
trap 'rm -f -- "$MOUNT_PROBE" "$SESSION_PROBE"' EXIT
# Permissions alone cannot distinguish a read-only mount from chmod 555 on a
# writable tree. Check the Linux mount table, not just access(2).
MOUNT_CHECK='[[ -d /mnt/pi-host-skills && -r "$1" && -r "$2" ]] || exit 1
printf "%s\n" shared > "$1" || exit 1
printf "%s\n" shared > "$2" || exit 1
while IFS=" " read -r id parent device root target options rest; do
  if [[ "$target" == /mnt/pi-host-skills && ",$options," == *,ro,* ]]; then exit 0; fi
done < /proc/self/mountinfo
exit 1'
if ! sbx exec --no-input -- "$SANDBOX_NAME" bash -c "$MOUNT_CHECK" \
  pi-sbx-check "$MOUNT_PROBE" "$SESSION_PROBE" </dev/null >/dev/null || [[ "$(< "$MOUNT_PROBE")" != shared || "$(< "$SESSION_PROBE")" != shared ]]; then
  rm -f -- "$MOUNT_PROBE" "$SESSION_PROBE"
  fail "sandbox $SANDBOX_NAME lacks the expected read-only skills/shared state mounts; migrate it explicitly (see pi-dev/README.md)"
fi
rm -f -- "$MOUNT_PROBE" "$SESSION_PROBE"
trap - EXIT

# Normal startup may take time; ADE version probes above never reach this call.
# A self-update must not leave the PRE-update release cached after exec.
if [[ "${1:-}" == update ]]; then
  rm -f -- "$VERSION_FILE"
elif ! refresh_version; then
  printf 'pi-sbx: could not cache installed Pi version; continuing without version metadata\n' >&2
fi

PI_ARGS=()
# Keep Pi's package/auth subcommands in argv[0], as required by its CLI parser.
PACKAGE_COMMAND=0
case "${1:-}" in install|remove|uninstall|update|list|config|auth|mcp) PACKAGE_COMMAND=1 ;; esac
if (( ! NO_SKILLS && ! PACKAGE_COMMAND )); then
  PI_ARGS+=(--skill "$SKILL_TARGET")
fi
# One bucket for interactive and RPC sessions; print/subcommands keep their
# existing persistence semantics. Explicit --session-dir remains untouched.
if (( ! PRINT && ! PACKAGE_COMMAND && ! SESSION_DIR_SET )); then
  PI_ARGS+=(--session-dir "$SESSION_DIR")
fi
if (( ! RPC )); then
  # Orca names chats via --print --mode text, with the prompt on stdin.
  # It needs raw pipes too, but not RPC session storage or resource rewriting.
  if (( PRINT )); then
    exec_piped_pi ${PI_ARGS[@]+"${PI_ARGS[@]}"} "$@"
  fi
  exec sbx run --name "$SANDBOX_NAME" --workdir "$PWD" --env "$PI_ENV" -- ${PI_ARGS[@]+"${PI_ARGS[@]}"} "$@"
fi

# Orca also injects host-side instructions/extensions/linked skills. Snapshot
# explicit resources outside the workspace into the shared state mount. This
# is launch-resource delivery, not automatic skill-picker synchronization.
RESOURCE_ROOT=''
RESOURCE_INDEX=0
stage_resource() {
  local value="$1" path destination original_name link depth=0
  STAGED_PATH="$value"
  path="$value"
  [[ "$path" == /* ]] || path="$PWD/$path"
  [[ -e "$path" ]] || return 0 # Inline prompts, built-ins, or sandbox paths.
  while [[ "$path" != / && "$path" == */ ]]; do path="${path%/}"; done
  original_name="$(basename "$path")"
  while [[ -L "$path" ]]; do
    depth=$((depth + 1))
    (( depth <= 40 )) || fail "too many resource symlinks: $value"
    link="$(readlink "$path")"
    if [[ "$link" == /* ]]; then path="$link"; else path="$(dirname "$path")/$link"; fi
  done
  if [[ -d "$path" ]]; then
    path="$(cd "$path" && pwd -P)"
  else
    path="$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
  fi
  case "$path" in
    "$HOST_SKILLS") STAGED_PATH="$SKILL_TARGET"; return 0 ;;
    "$HOST_SKILLS"/*) STAGED_PATH="$SKILL_TARGET/${path#"$HOST_SKILLS"/}"; return 0 ;;
    "$PWD"/*|"$PWD"|"$STATE_DIR"/*|"$STATE_DIR") STAGED_PATH="$path"; return 0 ;;
  esac
  [[ "$path" != / && "$STATE_DIR" != "$path"/* ]] || fail "cannot snapshot resource containing wrapper state: $value"
  if [[ -z "$RESOURCE_ROOT" ]]; then
    RESOURCE_ROOT="$(umask 077; mktemp -d "$STATE_DIR/resources.XXXXXXXX")"
  fi
  RESOURCE_INDEX=$((RESOURCE_INDEX + 1))
  destination="$RESOURCE_ROOT/$RESOURCE_INDEX"
  mkdir -- "$destination"
  # Resolve the requested root, but preserve links WITHIN directory snapshots:
  # dereferencing an arbitrary nested link could copy home/state recursively.
  # External link targets/dependencies still require an accessible mount.
  if ! cp -RP -- "$path" "$destination/$original_name"; then
    rm -rf -- "$destination"
    fail "could not snapshot resource: $value"
  fi
  STAGED_PATH="$destination/$original_name"
}
RPC_ARGS=()
while (( $# )); do
  case "$1" in
    --) RPC_ARGS+=("$@"); break ;;
    --extension|-e|--skill|--prompt-template|--theme|--system-prompt|--append-system-prompt)
      FLAG="$1"
      RPC_ARGS+=("$FLAG")
      shift
      if (( $# )); then
        stage_resource "$1"
        RPC_ARGS+=("$STAGED_PATH")
        shift
      fi ;;
    --session-dir)
      # Custom locations need an existing mount. Never silently create a host
      # path that might be private to the sandbox or intended read-only.
      RPC_ARGS+=("$1")
      shift
      if (( $# )); then RPC_ARGS+=("$1"); shift; fi ;;
    --provider|--model|--api-key|--thinking|--models|--session|--session-id|--fork|--name|-n|--tools|-t|--exclude-tools|-xt|--use-theme|--tui-mode|--mode|--export)
      RPC_ARGS+=("$1")
      shift
      if (( $# )); then RPC_ARGS+=("$1"); shift; fi ;;
    *) RPC_ARGS+=("$1"); shift ;;
  esac
done
exec_piped_pi ${PI_ARGS[@]+"${PI_ARGS[@]}"} "${RPC_ARGS[@]}"
